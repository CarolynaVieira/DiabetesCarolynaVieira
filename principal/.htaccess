<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>

  <FilesMatch "^favicon.*\.(ico|png)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# A antiga pagina /checkup/ foi incorporada a /prevencao/.
# Redireciona permanentemente para consolidar visitas e sinais de SEO.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^checkup/?$ /prevencao/ [R=301,L]
  RewriteRule ^checkup/.*$ /prevencao/ [R=301,L]
</IfModule>
